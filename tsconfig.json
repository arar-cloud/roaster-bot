{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2020"]
  },
  "include": ["src/**/*", "api/**/*"],
  "compilerOptions": {
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}